{
  "name": "solvfast-pms",
  "version": "1.0.0",
  "private": true,
  "description": "Solvfast PMS — static front-end",
  "scripts": {
    "start": "npx --yes serve . -l 4173",
    "build:css": "tailwindcss -i ./src/input.css -o ./assets/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./assets/css/tailwind.css --watch",
    "build": "npm run build:css && node scripts/build.js",
    "dev": "npm run watch:css"
  },
  "devDependencies": {
    "playwright": "^1.62.0",
    "tailwindcss": "^3.4.17"
  }
}
